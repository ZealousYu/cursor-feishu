# Copy to .env and fill in your Feishu app credentials.
# Get them from https://open.feishu.cn/app → your app → 凭证与基础信息

LARK_APP_ID=cli_xxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Open Platform API domain (for official lark-mcp login & MCP server)
# China: https://open.feishu.cn  |  International: https://open.larksuite.com
LARK_OPEN_DOMAIN=https://open.feishu.cn

# Tenant domain for lovelts/lark-mcp document tools only (NOT the API domain)
FEISHU_DOMAIN=feishu.cn

# Official MCP tool preset (optional override)
# LARK_OFFICIAL_TOOLS=preset.base.default,preset.doc.default,wiki.v2.spaceNode.move,docx.v1.documentBlock.list,...

# lark-cli auth domains (optional)
# LARK_CLI_AUTH_DOMAINS=docs,wiki,base,drive,calendar,im

# OAuth scopes for official MCP login script (wiki:wiki needed for moving wiki nodes)
# LARK_OAUTH_SCOPES=offline_access docx:document bitable:app drive:drive wiki:wiki wiki:wiki:readonly search:docs:read
